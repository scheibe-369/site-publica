---
import { Image } from "astro:assets";
import Icon from "@shared/ui/Icon.astro";
import { machine } from "../data/machine";
import { site } from "@shared/config/site";
import matheus from "@modules/mentors/assets/matheus.webp";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/reel-*.webp", { eager: true });
const reelImg = (f: string) => files[`../assets/${f}.webp`].default;
---
<section id="maquina" aria-labelledby="maquina-titulo" class="section relative isolate overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[40rem] w-[70rem] -translate-x-1/2 rounded-full bg-accent/[0.09] blur-[140px]"></div>

  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8" data-reveal>
        <p class="eyebrow">{machine.kicker}</p>
        <h2 id="maquina-titulo" class="mt-5 text-[2.4rem] font-extrabold leading-[1.02] md:text-6xl">
          Máquina de Edição: roteiro, edição e <span class="hl">postagem com IA.</span>
        </h2>
        <p class="mt-6 max-w-[56ch] text-lg leading-relaxed text-soft">
          Inclusa no PUBLICA. Aulas com Matheus Fonseca para roteirizar, editar e publicar seus vídeos automaticamente,
          com edição feita por IA. O PUBLICA mostra o que gravar. A Máquina resolve o que vem depois.
        </p>
      </div>
      <dl class="flex gap-10 lg:col-span-4 lg:justify-end" data-reveal>
        {machine.stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="num text-6xl font-black leading-none text-paper md:text-7xl">{s.value}</dd>
            <dd class="mt-2 text-sm text-soft">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Reels reais do Matheus, feitos com IA. Cada um abre no Instagram. -->
    <ul class="reels -mx-5 mt-16 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-6 md:mx-0 md:grid md:grid-cols-6 md:overflow-visible md:px-0 md:pb-0">
      {machine.reels.map((r, i) => (
        <li class:list={["reel w-[58vw] max-w-[230px] shrink-0 snap-start md:w-auto md:max-w-none", i % 2 === 1 && "md:translate-y-10"]}>
          <a href={r.url} target="_blank" rel="noopener" class="group block" aria-label={`Abrir no Instagram o Reel do Matheus com ${r.plays} reproduções`}>
            <div class="relative aspect-[9/16] overflow-hidden rounded-[22px] ring-1 ring-paper/12">
              <Image
                src={reelImg(r.file)}
                alt=""
                widths={[240, 400, 540]}
                sizes="(min-width: 768px) 15vw, 58vw"
                loading="lazy"
                decoding="async"
                class="size-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
              />
              <span class="absolute inset-0 grid place-items-center bg-ink/10 opacity-90 transition-opacity group-hover:opacity-100">
                <span class="grid size-12 place-items-center rounded-full bg-paper/90 text-ink shadow-lg backdrop-blur transition-transform duration-500 group-hover:scale-110">
                  <Icon name="playFill" class="ml-0.5 size-5" />
                </span>
              </span>
            </div>
            <p class="mt-3 flex items-center gap-1.5 text-sm text-soft">
              <Icon name="eye" class="size-4 text-accent" /><span class="font-semibold text-paper">{r.plays}</span> reproduções
            </p>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-xs text-mute md:mt-14">Reels do @matheusfonseca.ia produzidos com IA. Reproduções registradas em novembro de 2026.</p>

    <div class="mt-16 grid gap-10 lg:grid-cols-12">
      <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:col-span-8">
        {machine.benefits.map((b) => (
          <li data-reveal class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-paper/[0.06] text-accent"><Icon name={b.icon} class="size-5" /></span>
            <div>
              <h3 class="text-lg font-bold tracking-[-0.02em]">{b.title}</h3>
              <p class="mt-1.5 leading-relaxed text-soft">{b.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <div data-reveal class="card flex items-center gap-4 self-start p-5 lg:col-span-4">
        <Image src={matheus} alt="Matheus Fonseca" widths={[96, 192]} sizes="64px" loading="lazy" decoding="async" class="size-16 rounded-full object-cover" />
        <p class="text-sm leading-relaxed text-soft">
          <span class="block font-display text-base font-bold text-paper">Com Matheus Fonseca</span>
          <a href={site.teacher.instagram} target="_blank" rel="noopener" class="text-paper/80 underline decoration-paper/25 underline-offset-4 hover:decoration-accent">{site.teacher.handle}</a>, {machine.teacher.followers}
        </p>
      </div>
    </div>
  </div>
</section>
