---
import { Image } from "astro:assets";
import { cases } from "../data/cases";
import nichos1 from "../assets/nichos-1.webp";
import nichos2 from "../assets/nichos-2.webp";

const files = import.meta.glob<{ default: ImageMetadata }>("../assets/*.webp", { eager: true });
const img = (f: string) => files[`../assets/${f}.webp`].default;
---
<section id="resultados" aria-labelledby="casos-titulo" class="section">
  <div class="wrap">
    <div class="max-w-3xl" data-reveal>
      <h2 id="casos-titulo" class="text-[2.3rem] font-extrabold leading-[1.03] md:text-[3.4rem]">
        O mesmo processo, <span class="hl">em perfis diferentes.</span>
      </h2>
      <p class="mt-5 max-w-[56ch] text-lg text-soft">
        Perfis de clientes que tiveram trabalho direto do Vinicius. O PUBLICA entrega o mesmo processo em formato de guia. Os números saem dos prints originais.
      </p>
    </div>

    <!-- Pilha fixa: cada caso para no topo e o próximo passa por cima (CSS sticky, funciona sem JS) -->
    <ol class="mt-14 grid gap-6">
      {cases.map((c, i) => (
        <li class="case-card sticky" style={`top: calc(5.5rem + ${i} * 1.1rem)`}>
          <article class="grid gap-8 overflow-hidden rounded-[24px] border border-paper/10 bg-ink-3 p-6 shadow-[0_-20px_60px_-30px_rgb(0_0_0/0.9)] md:p-9 lg:grid-cols-12 lg:items-center lg:gap-10">
            <div class="lg:col-span-5">
              <p class="text-sm text-mute">{c.niche}</p>
              <h3 class="mt-1 text-2xl font-extrabold md:text-[1.7rem]">{c.name}</h3>
              <p class="num mt-6 text-5xl font-black leading-none text-accent md:text-6xl">{c.headline}</p>
              <p class="mt-2 font-display font-bold text-paper">{c.unit}</p>
              <p class="mt-4 leading-relaxed text-soft">{c.detail}</p>
              <p class="mt-6 border-l-2 border-accent pl-4 text-[0.95rem] leading-relaxed text-paper/80">{c.lesson}</p>
            </div>
            <figure class="lg:col-span-7">
              <Image
                src={img(c.file)}
                alt={c.alt}
                widths={[480, 760, 1100]}
                sizes="(min-width: 1024px) 620px, 90vw"
                loading="lazy"
                decoding="async"
                class="w-full rounded-2xl ring-1 ring-paper/10"
              />
              <figcaption class="mt-3 text-xs text-mute">Print original do perfil, no momento do registro.</figcaption>
            </figure>
          </article>
        </li>
      ))}
    </ol>

    <div class="mt-20" data-reveal>
      <h3 class="text-2xl font-extrabold md:text-3xl">Outros perfis com que o Vinicius já trabalhou</h3>
      <p class="mt-3 text-soft">Tintas, pintura, decoração, reformas, política e advocacia.</p>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <Image src={nichos1} alt="Perfis Parede Perfeita com 663 mil seguidores, Tauan Decor com 214 mil e Marcos Venieris com 193 mil" widths={[480, 800, 1200]} sizes="(min-width: 768px) 46vw, 92vw" loading="lazy" decoding="async" class="w-full rounded-[20px] ring-1 ring-paper/10" />
        <Image src={nichos2} alt="Perfis Melquiades Art Pintura com 87,1 mil seguidores, Guimedon com 29,1 mil e Sabrina Blaustein com 20,6 mil" widths={[480, 800, 1200]} sizes="(min-width: 768px) 46vw, 92vw" loading="lazy" decoding="async" class="w-full rounded-[20px] ring-1 ring-paper/10" />
      </div>
    </div>

    <p class="mt-10 max-w-[80ch] text-sm leading-relaxed text-mute">
      O PUBLICA não inclui acompanhamento individual. Os números mostram a audiência em cada print, no momento do registro.
      O resultado depende do tema, da execução e do público.
    </p>
  </div>
</section>
