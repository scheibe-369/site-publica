---
import { Image } from "astro:assets";
import Icon from "@shared/ui/Icon.astro";
import { parts, bonuses } from "../data/curriculum";
import pageIdeias from "../assets/page-ideias.webp";
import pagePlano from "../assets/page-plano.webp";
const bonusImages = [pageIdeias, pagePlano];
---
<section id="conteudo" aria-labelledby="conteudo-titulo" class="section bg-ink-2">
  <div class="wrap">
    <div class="max-w-2xl" data-reveal>
      <h2 id="conteudo-titulo" class="text-[2.3rem] font-extrabold leading-[1.03] md:text-5xl">O que tem dentro do PUBLICA.</h2>
      <p class="mt-5 text-lg text-soft">Dez partes para aplicar na ordem, mais dois bônus prontos para usar. É o sumário do e-book.</p>
    </div>

    <!-- Sumário no formato do próprio e-book: parte, título, linha pontilhada e página -->
    <div data-reveal class="mt-14 rounded-[24px] border border-paper/10 bg-ink p-6 md:p-10">
      <ol class="grid gap-x-14 gap-y-7 lg:grid-cols-2">
        {parts.map((p) => (
          <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-3">
            <div class="min-w-0">
              <p class="font-display text-xs font-bold uppercase tracking-[0.16em] text-accent">Parte {p.n}</p>
              <h3 class="mt-1.5 flex items-baseline gap-3 text-lg font-bold tracking-[-0.02em]">
                <span>{p.title}</span>
                <span aria-hidden="true" class="mb-1 hidden flex-1 border-b border-dotted border-paper/25 sm:block"></span>
              </h3>
              <p class="mt-1 text-[0.95rem] leading-relaxed text-soft">{p.body}</p>
            </div>
            <span class="num self-start pt-6 text-sm font-bold text-paper/60">p.&nbsp;{p.page}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-5 grid gap-5 md:grid-cols-2">
      {bonuses.map((b, i) => (
        <article data-reveal class="card relative grid overflow-hidden sm:grid-cols-[1fr_auto]">
          <div class="p-7 md:p-8">
            <p class="flex items-center gap-2 font-display text-sm font-bold text-accent">
              <Icon name="gift" class="size-4" /> {b.tag}
              <span class="num font-bold text-paper/50">p.&nbsp;{b.page}</span>
            </p>
            <h3 class="mt-3 text-2xl font-extrabold">{b.title}</h3>
            <p class="mt-3 leading-relaxed text-soft">{b.body}</p>
          </div>
          <div class="relative hidden w-[180px] overflow-hidden sm:block">
            <Image
              src={bonusImages[i]}
              alt={`Página do e-book: ${b.title}`}
              widths={[240, 400]}
              sizes="180px"
              loading="lazy"
              decoding="async"
              class="absolute left-4 top-8 w-[200px] rotate-[4deg] rounded-md shadow-[0_20px_50px_-10px_rgb(0_0_0/0.9)]"
            />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
