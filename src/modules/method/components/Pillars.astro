---
import Icon from "@shared/ui/Icon.astro";
import { pillars } from "../data/method";
---
<section aria-labelledby="pilares-titulo" class="section glow-top relative border-y border-paper/[0.07]">
  <div class="wrap">
    <div class="max-w-2xl" data-reveal>
      <h2 id="pilares-titulo" class="text-[2.2rem] font-extrabold leading-[1.04] md:text-5xl">
        Cinco pilares, aplicados na ordem.
      </h2>
      <p class="mt-5 text-lg text-soft">Cada pilar prepara o próximo. É o ciclo que o Vinicius repete no perfil dele e no de clientes.</p>
    </div>

    <ol class="pillars relative mt-16 grid gap-10 md:grid-cols-5 md:gap-6">
      <!-- Trilho: preenche em vermelho conforme o scroll (mostra a ordem do método) -->
      <div aria-hidden="true" class="absolute left-6 top-6 hidden h-px bg-paper/12 md:right-[calc((100%_-_6rem)/5_-_24px)] md:block">
        <div class="pillars-fill absolute inset-0 origin-left bg-accent"></div>
      </div>
      {pillars.map((p) => (
        <li data-reveal class="relative pl-16 md:pl-0">
          <span class="pillar-node absolute left-0 top-0 grid size-12 place-items-center rounded-full bg-ink text-paper ring-1 ring-paper/20 md:relative">
            <Icon name={p.icon} class="size-5" />
          </span>
          <h3 class="text-xl font-extrabold md:mt-6">{p.title}</h3>
          <p class="mt-2 leading-relaxed text-soft">{p.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, motionEnabled } from "@shared/motion/motion";
  if (motionEnabled()) {
    gsap.registerPlugin(ScrollTrigger);
    gsap.matchMedia().add("(min-width: 768px)", () => {
      gsap.fromTo(".pillars-fill", { scaleX: 0 }, {
        scaleX: 1,
        ease: "none",
        scrollTrigger: { trigger: ".pillars", start: "top 75%", end: "bottom 55%", scrub: 0.6 },
      });
    });
  }
</script>
