---
import Icon from "@shared/ui/Icon.astro";
import { offer } from "../data/offer";
import GuaranteeSeal from "./GuaranteeSeal.astro";

const points = ["Reembolso integral", "Sem precisar justificar", `Prazo de ${offer.guaranteeDays} dias`];
---
<section aria-labelledby="garantia-titulo" class="section relative overflow-hidden">
  <div class="wrap">
    <div class="mx-auto grid max-w-5xl items-center gap-12 lg:grid-cols-[21rem_1fr] lg:gap-20">
      <div data-reveal class="relative mx-auto w-60 md:w-72 lg:w-full">
        <div aria-hidden="true" class="absolute inset-[14%] rounded-full bg-accent/30 blur-[70px]"></div>
        <GuaranteeSeal days={offer.guaranteeDays} class="seal-stamp relative h-auto w-full" />
      </div>

      <div class="text-center lg:text-left">
        <p class="eyebrow" data-reveal>Garantia incondicional</p>
        <h2 id="garantia-titulo" data-reveal class="mt-4 text-[2.2rem] font-extrabold leading-[1.05] md:text-5xl">
          {offer.guaranteeDays} dias para decidir com calma.
        </h2>
        <p data-reveal class="mx-auto mt-6 max-w-[56ch] text-lg leading-relaxed text-soft lg:mx-0">
          Compre, leia o e-book, assista à aula e faça o Dia 1 do plano. Se achar que o PUBLICA não é para você,
          peça o reembolso em até {offer.guaranteeDays} dias e receba o valor de volta, sem precisar justificar.
          É o direito de arrependimento previsto no Código de Defesa do Consumidor.
        </p>
        <ul data-reveal class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 font-display text-sm font-bold text-paper lg:justify-start">
          {points.map((p) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-4 text-accent" /> {p}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Efeito de carimbo: o selo entra maior e girado e assenta quando a seção aparece.
     Global porque a classe é aplicada dentro do componente GuaranteeSeal. */
  .seal-stamp {
    transition: transform 0.9s cubic-bezier(0.2, 1.35, 0.35, 1) 0.1s, opacity 0.45s ease 0.1s;
  }
  .motion [data-reveal]:not(.is-in) .seal-stamp {
    opacity: 0;
    transform: scale(1.3) rotate(-16deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .seal-stamp { transition: none; }
  }
</style>
