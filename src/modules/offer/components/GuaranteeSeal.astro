---
// Selo de garantia no formato clássico (roseta serrilhada, anel de texto e fitas), desenhado em SVG nas cores da marca.
// SVG inline (não <img>) para herdar a Montserrat da página e ficar nítido em qualquer tamanho.
interface Props {
  days: number;
  id?: string;
  class?: string;
}
const { days, id = "selo", class: className } = Astro.props;

const cx = 130;
const cy = 130;

// Roseta: estrela de 2N vértices alternando raio externo e interno.
const N = 44;
const burst = Array.from({ length: N * 2 }, (_, i) => {
  const r = i % 2 === 0 ? 124 : 114.5;
  const a = (Math.PI * i) / N - Math.PI / 2;
  return `${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`;
}).join(" ");

// Caminho circular (começa às 9h, sentido horário) para o texto do anel.
const ringR = 79;
const ringPath = `M ${cx - ringR},${cy} a ${ringR},${ringR} 0 1,1 ${2 * ringR},0 a ${ringR},${ringR} 0 1,1 ${-2 * ringR},0`;
const ringLength = (2 * Math.PI * ringR).toFixed(2);

// Anel pontilhado com espaçamento exato (sem emenda visível).
const dotsR = 64;
const dotGap = ((2 * Math.PI * dotsR) / 52).toFixed(3);

const ringWord = "GARANTIA INCONDICIONAL";
---
<svg
  viewBox="0 0 260 296"
  role="img"
  aria-label={`Selo de garantia incondicional de ${days} dias`}
  class:list={["seal", className]}
>
  <defs>
    <radialGradient id={`${id}-red`} cx="36%" cy="30%" r="75%">
      <stop offset="0" stop-color="#FF6A4D" />
      <stop offset="0.55" stop-color="#FF3B1F" />
      <stop offset="1" stop-color="#C4260D" />
    </radialGradient>
    <linearGradient id={`${id}-tail`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C4260D" />
      <stop offset="1" stop-color="#8F1A07" />
    </linearGradient>
    <radialGradient id={`${id}-disc`} cx="40%" cy="30%" r="80%">
      <stop offset="0" stop-color="#262626" />
      <stop offset="1" stop-color="#0A0A0A" />
    </radialGradient>
    <linearGradient id={`${id}-shine`} x1="0.15" y1="0" x2="0.75" y2="0.85">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.38" />
      <stop offset="0.45" stop-color="#FFFFFF" stop-opacity="0" />
    </linearGradient>
    <path id={`${id}-ring`} d={ringPath} fill="none" />
  </defs>

  <!-- Fitas atrás da roseta -->
  <polygon points="92,196 128,210 104,292 88.5,268 68,282" fill={`url(#${id}-tail)`} />
  <polygon points="168,196 132,210 156,292 171.5,268 192,282" fill={`url(#${id}-tail)`} />

  <!-- Roseta serrilhada com brilho -->
  <polygon points={burst} fill={`url(#${id}-red)`} />
  <polygon points={burst} fill={`url(#${id}-shine)`} />

  <!-- Aro claro e disco central -->
  <circle cx={cx} cy={cy} r="105" fill="none" stroke="#F4F2EE" stroke-width="2.5" />
  <circle cx={cx} cy={cy} r="99" fill={`url(#${id}-disc)`} />
  <circle cx={cx} cy={cy} r="99" fill="none" stroke="#FFFFFF" stroke-opacity="0.08" stroke-width="1" />

  <!-- Anel de texto (gira devagar) -->
  <g class="seal-ring">
    <text font-family="Montserrat Variable, Montserrat, sans-serif" font-size="12.5" font-weight="800" fill="#F4F2EE">
      <textPath href={`#${id}-ring`} textLength={ringLength} lengthAdjust="spacing">
        {ringWord} <tspan fill="#FF3B1F">•</tspan> {ringWord} <tspan fill="#FF3B1F">•</tspan>
      </textPath>
    </text>
  </g>

  <circle
    cx={cx}
    cy={cy}
    r={dotsR}
    fill="none"
    stroke="#FF3B1F"
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-dasharray={`0.01 ${dotGap}`}
  />

  <!-- Número e legenda -->
  <text
    x={cx}
    y="152"
    text-anchor="middle"
    font-family="Montserrat Variable, Montserrat, sans-serif"
    font-size="94"
    font-weight="900"
    letter-spacing="-3"
    fill="#F4F2EE">{days}</text>
  <text
    x={cx + 2}
    y="178"
    text-anchor="middle"
    font-family="Montserrat Variable, Montserrat, sans-serif"
    font-size="15"
    font-weight="800"
    letter-spacing="4"
    fill="#FF3B1F">DIAS</text>
</svg>

<style>
  .seal {
    filter: drop-shadow(0 26px 34px rgb(0 0 0 / 0.55));
  }
  .seal-ring {
    transform-box: view-box;
    transform-origin: 130px 130px;
    animation: seal-spin 60s linear infinite;
  }
  @keyframes seal-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .seal-ring { animation: none; }
  }
</style>
