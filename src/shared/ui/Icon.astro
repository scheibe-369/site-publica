---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}
const { name, class: cls = "size-5", label } = Astro.props;
const svg = icons[name]
  .replace("<svg ", `<svg class="${cls}" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'} `);
---
<Fragment set:html={svg} />
